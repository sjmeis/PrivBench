{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Flask App (Debug with Breakpoints)",
            "type": "debugpy",
            "request": "launch",
            "module": "flask",
            "args": [
                "run",
                "--host=0.0.0.0",
                "--port=5000",
                "--no-debugger",
                "--no-reload"
            ],
            "env": {
                "FLASK_APP": "app",
                "FLASK_ENV": "development",
                "FLASK_DEBUG": "1",
                "PYTHONPATH": "${workspaceFolder}"
            },
            "cwd": "${workspaceFolder}/backend",
            "console": "integratedTerminal",
            "justMyCode": false,
            "jinja": true,
            "envFile": "${workspaceFolder}/backend/.env",
            "stopOnEntry": false,
            "redirectOutput": true
        },
        {
            "name": "Attach to Flask via debugpy",
            "type": "debugpy",
            "request": "attach",
            "connect": {
                "host": "localhost",
                "port": 5678
            },
            "justMyCode": false,
            "redirectOutput": true,
        },
        {
            "name": "Flask App (Auto-reload)",
            "type": "debugpy",
            "request": "launch",
            "module": "flask",
            "args": [
                "run",
                "--host=0.0.0.0",
                "--port=5000"
            ],
            "env": {
                "FLASK_APP": "app",
                "FLASK_ENV": "development",
                "FLASK_DEBUG": "1",
                "PYTHONPATH": "${workspaceFolder}"
            },
            "cwd": "${workspaceFolder}/backend",
            "console": "integratedTerminal",
            "justMyCode": false,
            "jinja": true,
            "envFile": "${workspaceFolder}/backend/.env"
        },
        {
            "name": "Celery Worker (Debug)",
            "type": "debugpy",
            "request": "launch",
            "module": "celery",
            "args": [
                "-A",
                "app.celery",
                "worker",
                "--loglevel=debug",
                "--pool=solo"
            ],
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            },
            "cwd": "${workspaceFolder}/backend",
            "console": "integratedTerminal",
            "justMyCode": false,
            "envFile": "${workspaceFolder}/backend/.env"
        },
        {
            "name": "Setup Database (Debug)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/backend/setup-db.py",
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            },
            "cwd": "${workspaceFolder}/backend",
            "console": "integratedTerminal",
            "justMyCode": false,
            "envFile": "${workspaceFolder}/backend/.env"
        },
        {
            "name": "Populate Database (Debug)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/backend/populate-db.py",
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            },
            "cwd": "${workspaceFolder}/backend",
            "console": "integratedTerminal",
            "justMyCode": false,
            "envFile": "${workspaceFolder}/backend/.env"
        },
        {
            "name": "Debug Auth Routes",
            "type": "debugpy",
            "request": "launch",
            "module": "flask",
            "args": [
                "--app",
                "app",
                "run",
                "--host=0.0.0.0",
                "--port=5000",
                "--no-debugger",
                "--no-reload"
            ],
            "env": {
                "FLASK_APP": "app",
                "FLASK_ENV": "development",
                "FLASK_DEBUG": "1",
                "PYTHONPATH": "${workspaceFolder}"
            },
            "cwd": "${workspaceFolder}/backend",
            "console": "integratedTerminal",
            "justMyCode": false,
            "jinja": true,
            "envFile": "${workspaceFolder}/backend/.env",
            "stopOnEntry": false
        },
        {
            "name": "Python: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "justMyCode": false,
            "cwd": "${workspaceFolder}/backend",
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            },
            "envFile": "${workspaceFolder}/backend/.env"
        },
        {
            "name": "Chrome: Frontend",
            "type": "chrome",
            "request": "launch",
            "url": "http://localhost:3000",
            "webRoot": "${workspaceFolder}/frontend",
            "sourceMapPathOverrides": {
                "webpack:///src/*": "${webRoot}/src/*"
            }
        },
        {
            "name": "Attach to Chrome",
            "type": "chrome",
            "request": "attach",
            "port": 9222,
            "webRoot": "${workspaceFolder}/frontend",
            "sourceMapPathOverrides": {
                "webpack:///src/*": "${webRoot}/src/*"
            }
        }
    ],
    "compounds": [
        {
            "name": "Full Stack: Frontend + Backend",
            "configurations": ["Flask App (Debug with Breakpoints)", "Chrome: Frontend"]
        },
        {
            "name": "Backend + Celery",
            "configurations": ["Flask App (Debug with Breakpoints)", "Celery Worker (Debug)"]
        }
    ]
} 